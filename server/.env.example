# ===== TopUpSaja API — contoh environment =====
# Copy ke .env lalu isi nilai aslinya. JANGAN commit .env.

# --- Core ---
API_PORT=3000
BASE_URL=https://topupsaja.com
API_PUBLIC_URL=https://api.topupsaja.com
NODE_ENV=production

# --- Database (Supabase Postgres connection string / pooler) ---
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Auth ---
JWT_SECRET=ganti-dengan-random-64-char

# --- Google login (GIS) ---
# OAuth Client ID (Web application) dari Google Cloud Console. Kosong = fitur off.
GOOGLE_CLIENT_ID=

# --- OpenRouter (upstream) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Email admin (dipakai untuk bootstrap role admin saat register)
ADMIN_EMAILS=admin@topupsaja.com

# --- Margin & pricing ---
# Nilai 1 credit dalam USD (basis konversi multiplier). Jangan diubah tanpa audit.
CREDIT_USD_VALUE=0.0000001
# Markup per-tier atas cost upstream (model murah markup lebih tinggi)
OPENROUTER_FEE_HEMAT=7.0
OPENROUTER_FEE_STANDAR=6.0
OPENROUTER_FEE_PREMIUM=5.0
# Kurs fallback jika auto-fetch gagal
IDR_PER_USD=16000

# --- Alert (Telegram bot admin) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- QRIS provider ---
# manual  = bukti transfer di-approve admin (default, jalan tanpa vendor)
# generic = gateway QRIS pihak ketiga dengan endpoint create-invoice + webhook
QRIS_PROVIDER=manual

# Untuk QRIS_PROVIDER=generic (sesuaikan dengan vendor yang Anda pilih)
QRIS_GENERIC_BASE_URL=
QRIS_GENERIC_API_KEY=
QRIS_GENERIC_WEBHOOK_SECRET=

# Untuk QRIS_PROVIDER=tripay (tripay.co.id) — kredensial dari dashboard merchant
# TRIPAY_MODE: production | sandbox (base URL https://tripay.co.id/api[-sandbox])
TRIPAY_MODE=production
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_METHOD=QRIS2
