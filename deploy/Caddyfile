# /etc/caddy/Caddyfile — reverse proxy + TLS otomatis (Let's Encrypt)
# topupsaja.com → web (localhost:3000), api.topupsaja.com → API (localhost:3001)

(security-headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.topupsaja.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

topupsaja.com {
	encode zstd gzip
	import security-headers
	reverse_proxy localhost:3000
}

api.topupsaja.com {
	encode zstd gzip
	import security-headers
	reverse_proxy localhost:3001
}
