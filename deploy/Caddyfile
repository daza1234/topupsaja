# /etc/caddy/Caddyfile — reverse proxy + TLS otomatis (Let's Encrypt)
# DNS ai.topupsaja.com dan api.topupsaja.com HARUS sudah mengarah ke IP VM ini
# sebelum Caddy start, supaya issuance sertifikat berhasil.

(security-headers) {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-XSS-Protection "0"
}

ai.topupsaja.com {
	encode zstd gzip
	import security-headers
	# CSP mulai Report-Only — enforce setelah 1 hari tanpa laporan pelanggaran.
	Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.topupsaja.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	reverse_proxy localhost:3000
}

api.topupsaja.com {
	encode zstd gzip
	import security-headers
	Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.topupsaja.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	reverse_proxy localhost:3001
}
