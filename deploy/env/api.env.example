# ===== TopUpSaja API — PRODUCTION (VM Oracle) =====
# Copy ke /opt/topupsaja/server/.env lalu: chmod 600 .env
# Ganti semua nilai bertanda GANTI.

# --- Core ---
API_PORT=3001
BASE_URL=https://ai.topupsaja.com
API_PUBLIC_URL=https://api.topupsaja.com
NODE_ENV=production

# --- Database (Postgres lokal di VM yang sama) ---
DATABASE_URL=postgresql://topupsaja:GANTI_PASSWORD_DB@localhost:5432/topupsaja

# --- Auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=GANTI_RANDOM_64_CHAR

# --- Google login (GIS) ---
# OAuth Client ID (Web application) dari Google Cloud Console. Kosong = fitur off.
GOOGLE_CLIENT_ID=

# --- OpenRouter (upstream) ---
OPENROUTER_API_KEY=GANTI_sk-or-v1-xxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADMIN_EMAILS=GANTI_email_admin

# --- Margin & pricing (sama seperti dev) ---
CREDIT_USD_VALUE=0.0000001
OPENROUTER_FEE_HEMAT=7.0
OPENROUTER_FEE_STANDAR=6.0
OPENROUTER_FEE_PREMIUM=5.0
IDR_PER_USD=16000

# --- Alert (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- QRIS ---
# manual  = approve admin; tripay = QRIS otomatis via tripay.co.id
QRIS_PROVIDER=manual

# Kredensial Tripay (dari dashboard merchant tripay.co.id)
TRIPAY_MODE=production
TRIPAY_MERCHANT_CODE=GANTI
TRIPAY_API_KEY=GANTI
TRIPAY_PRIVATE_KEY=GANTI
TRIPAY_METHOD=QRIS2
